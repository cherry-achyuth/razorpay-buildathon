# ==============================================================================
# DecisionVault Environment Configuration
# Copy this file to .env and adjust variables as needed.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Application Metadata
PROJECT_NAME="DecisionVault"
APP_ENV="development"
DEBUG=false
LOG_LEVEL="INFO"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database Configuration
# Format: postgresql+asyncpg://user:password@host:port/dbname
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="decisionvault"
POSTGRES_PASSWORD="decisionvault_secret_password"
POSTGRES_DB="decisionvault"

# Explicit DATABASE_URL override (optional - if omitted, constructed from POSTGRES_* fields)
DATABASE_URL="postgresql+asyncpg://decisionvault:decisionvault_secret_password@localhost:5432/decisionvault"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Razorpay Test Mode Payment Gateway
# Obtain test credentials from https://dashboard.razorpay.com/app/keys
# If credentials are omitted or invalid, DecisionVault uses deterministic SANDBOX_SIMULATION fallback.
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_secret_key_here"
RAZORPAY_CURRENCY_DEFAULT="INR"
RAZORPAY_MOCK_FALLBACK=true

# AI Buying Agent & LLM Provider Configuration
# Optional: If omitted, DecisionVault automatically uses its deterministic semantic intent parser.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Deterministic Guardrails & Safety Parameters
DUPLICATE_DETECTION_WINDOW_SECONDS=300
PRICE_DRIFT_THRESHOLD_PERCENT=25.0
PRICE_DRIFT_MIN_SAMPLES=3
HISTORICAL_LOOKBACK_DAYS=90

# Financial Memory & Semantic Embedding
EMBEDDING_PROVIDER="deterministic"
EMBEDDING_MODEL="decisionvault-embed-v1"
MEMORY_COMPRESSION_LOOKBACK_DAYS=90
MEMORY_COMPRESSION_MAX_SOURCE_EVENTS=500
